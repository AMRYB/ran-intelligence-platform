# Docker / Swarm configuration
COMPOSE_PROJECT_NAME=ran-intelligence-platform

# Kafka
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper1:2181,zookeeper2:2181,zookeeper3:2181
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka1:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=3
KAFKA_NUM_PARTITIONS=5

# Hadoop
HADOOP_HOME=/opt/hadoop
HDFS_NAMENODE_HOST=namenode1
HDFS_DATANODE_HOST=datanode1

# Spark
SPARK_MASTER_URL=spark://spark-master1:7077
SPARK_APP_NAME=ran-streaming

# ClickHouse
CLICKHOUSE_DB=ran_telemetry
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Producer
TOPIC_NAME=ran-telemetry
PRODUCER_BATCH_SIZE=100
PRODUCER_SLEEP_SECONDS=2

# Data paths
DATA_DIR=/data
